{
  appId: "com.tachiiri.claude-launcher",
  productName: "Claude Launcher",
  directories: {
    buildResources: "build",
    output: "dist",
  },
  files: ["out/**/*"],
  publish: [
    {
      provider: "github",
      owner: "tachiiri-org",
      repo: "claude-launcher",
    },
  ],
  win: {
    target: [
      {
        target: "nsis",
        arch: ["x64"],
      },
    ],
  },
  nsis: {
    oneClick: false,
    allowToChangeInstallationDirectory: true,
  },
}
